{
  // VSCode workspace for the kernel tree. Open this file instead of opening
  // the directory directly.
  //
  // Project decision: this workspace has no tasks, and this tree is never
  // built in place. Build, boot, test and benchmark from linux-rust. Its
  // scripts link compile_commands.json and rust-project.json into this tree's
  // root, where clangd and rust-analyzer find them.
  //
  // Project decision: this workspace is the supported editor setup for this
  // tree. See AGENTS.md for project direction.
  //
  // Settings precedence (merged in order):
  //  0) default settings
  //  1) user's settings
  //  2) remote machine settings
  //  3) workspace settings  (this file)
  //  4) workspace folder settings
  //
  // See https://code.visualstudio.com/docs/getstarted/settings#_settings-precedence

  ////////
  // VSCode Workspace Contents
  "folders": [
    {
      // The whole kernel tree.
      "path": "."
    }
  ],

  ////////
  // Recommended Extensions
  //
  "extensions": {
    "recommendations": [
      // The official Clang LSP for C. Uses compile_commands.json.
      "llvm-vs-code-extensions.vscode-clangd",

      // The official LSP for Rust (rust/ and Rust drivers).
      "rust-lang.rust-analyzer",

      // Python for scripts/ and tools/.
      "ms-python.python",

      // Kconfig syntax and navigation.
      "luveti.kconfig",

      // Devicetree (.dts/.dtsi) syntax and navigation.
      "plorefice.devicetree",

      // reStructuredText for Documentation/.
      "lextudio.restructuredtext",

      // GNU assembler syntax for .S files.
      "13xforever.language-x86-64-assembly",

      // Enforces .editorconfig.
      "editorconfig.editorconfig",
    ],

    "unwantedRecommendations": [
      // Conflicts with vscode-clangd intellisense, and vscode-clangd is the
      // preferred C extension.
      "ms-vscode.cpptools",
    ]
  },


  "settings": {
    ////////
    // Extra file associations (patterns to languages)
    "files.associations": {
      "Kconfig*": "kconfig",
      "Kbuild*": "makefile",
      "Makefile.*": "makefile",
      "*.mk": "makefile",
      "*.h": "c",
      "*.S": "asm-intel-x86-generic",
      "*.dts": "dts",
      "*.dtsi": "dts",
      "*.dtso": "dts",
      "*.rst": "restructuredtext",
      "*.cocci": "plaintext",
    },

    ////////
    // Kernel coding style (Documentation/process/coding-style.rst)
    "editor.insertSpaces": false,
    "editor.tabSize": 8,
    "editor.detectIndentation": false,
    "editor.rulers": [
        80,
        100
    ],
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,

    // Disable graph visualization of incoming/outgoing changes. The kernel's
    // history is very deep and this causes infinite loading in the
    // "Source Control" tab.
    "scm.showHistoryGraph": false,
    "git.detectSubmodules": false,

    ////////
    // Rust
    //
    "[rust]": {
      "editor.insertSpaces": true,
      "editor.tabSize": 4,
      "editor.rulers": [
        100
      ],
      "editor.defaultFormatter": "rust-lang.rust-analyzer"
    },

    // This works around an OOM issue with the vscode extension-host's
    // implementation of file-watching.
    // see:  https://github.com/rust-lang/rust-analyzer/issues/12572
    "rust-analyzer.files.watcher": "server",

    // rust-project.json is discovered in the tree root, where linux-rust's
    // `scripts/make.sh LLVM=1 rust-analyzer` links it.

    // The kernel is not a cargo project; checking via cargo would fail.
    "rust-analyzer.check.overrideCommand": null,
    "rust-analyzer.checkOnSave": false,
    "rust-analyzer.cargo.buildScripts.enable": false,

    // Use the kernel's rustfmt configuration.
    "rust-analyzer.rustfmt.overrideCommand": [
      "rustfmt",
      "--config-path=${workspaceFolder}/.rustfmt.toml"
    ],

    ////////
    // C

    "clangd.arguments": [
        "--background-index",
        "--header-insertion=never",
        // compile_commands.json is found in the tree root, where linux-rust's
        // `scripts/make.sh compile_commands.json` links it.
        // The kernel builds with GCC by default; don't let clang-tidy flood
        // diagnostics.
        "--clang-tidy=false",
    ],

    "[c]": {
      "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
      // Kernel code is not uniformly clang-formatted; format explicitly.
      "editor.formatOnSave": false
    },

    ////////
    // Python
    //
    "[python]": {
      "editor.insertSpaces": true,
      "editor.tabSize": 4
    },

    ////////
    // Makefiles need tabs.
    "[makefile]": {
      "editor.insertSpaces": false,
      "editor.tabSize": 8
    },

    ////////
    // Documentation
    //
    "[restructuredtext]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.rulers": [
            80
        ]
    },
    "[markdown]": {
        "editor.rulers": [
            80
        ]
    },

    ////////
    // VSCode file exclusions
    //

    // Files that are hidden in the Workspace Explorer (build artifacts).
    "files.exclude": {
      "**/.git": true,
      "**/__pycache__": true,
      "**/*.o": true,
      "**/*.o.*": true,
      "**/*.a": true,
      "**/*.ko": true,
      "**/*.mod": true,
      "**/*.mod.c": true,
      "**/*.cmd": true,
      "**/.*.cmd": true,
      "**/*.d": true,
      "**/.*.d": true,
      "**/*.symtypes": true,
      "**/modules.order": true,
      "**/.tmp_*": true,
    },

    // Files that are excluded from file-watching notifications.
    "files.watcherExclude": {
      "**/.git/**": true,
      "**/*.o": true,
      "**/*.cmd": true,
      "**/.*.cmd": true,
      "**/.tmp_*/**": true,
      ".cache/**": true,
      "Documentation/output/**": true,
    },

    // Files that are excluded from search and quick open (^P).
    "search.exclude": {
      "**/*.o": true,
      "**/*.ko": true,
      "**/*.cmd": true,
      "**/.*.cmd": true,
      "**/*.mod.c": true,
      "**/modules.order": true,
      "**/.tmp_*": true,
      ".cache/**": true,
      "compile_commands.json": true,
      "rust-project.json": true,
      "Documentation/output/**": true,
      "vmlinux*": true,
      "System.map": true,
      "Module.symvers": true,
    },
    "search.useIgnoreFiles": true,
    // Don't follow symlinks (e.g. source/ in out-of-tree builds).
    "search.followSymlinks": false,

    // Disable task auto-detection. This significantly speeds up task running.
    "task.autoDetect": "off",
  },
}
